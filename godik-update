#!/usr/bin/env bash
# Update GODIK CODER: pull Ken's latest code (./sync-upstream), then rebuild the
# Mac app and put it in ~/Applications. Stops on merge conflicts or build errors.
#   ./godik-update            # sync + build + install
#   ./godik-update --no-sync  # just rebuild + install what's checked out
#   ./godik-update --install  # only copy the last build into ~/Applications
# Quit GODIK CODER before installing: a running copy must not be swapped out
# underneath itself. The script checks and stops if it's open.
set -euo pipefail
cd "$(dirname "$0")"

APP_NAME="GODIK CODER"
DEST="$HOME/Applications/$APP_NAME.app"
BUILT="gg-app/src-tauri/target/release/bundle/macos/$APP_NAME.app"

# Rust is installed per-user by rustup and may not be on PATH in this shell.
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
for tool in pnpm cargo; do
  command -v "$tool" >/dev/null || { echo "STOP: '$tool' not found. Install it first (Rust: https://rustup.rs)." >&2; exit 1; }
done

# ps, not pgrep: pgrep misses these processes on macOS once their bundle moves.
running() { ps -axo args | grep -F "$APP_NAME.app/Contents/MacOS/" | grep -qv grep; }

if [ "${1:-}" != "--install" ]; then
  if [ "${1:-}" != "--no-sync" ]; then
    ./sync-upstream   # exits 1 with a clear message on conflicts; we stop here too
  fi

echo "Installing dependencies..."
pnpm install --frozen-lockfile >/dev/null

echo "Building the agent, Node runtime and sidecar..."
pnpm --filter @kenkaiiii/ggcoder build >/dev/null
pnpm --filter gg-app stage:node
pnpm --filter gg-app bundle:sidecar

echo "Building the Mac app (this takes a few minutes)..."
# Local builds have no updater signing key, so skip the updater artifacts
# (.app.tar.gz + .sig) here at runtime. The committed tauri.conf.json keeps
# createUpdaterArtifacts: true for CI (.github/workflows/godik-release.yml),
# and the app built here still checks the fork's releases for updates.
pnpm --filter gg-app tauri build --bundles app --config '{"bundle":{"createUpdaterArtifacts":false}}'

fi

[ -d "$BUILT" ] || { echo "STOP: no build at $BUILT." >&2; exit 1; }

if running; then
  echo "STOP: $APP_NAME is open. The new build is ready; quit $APP_NAME and run: ./godik-update --install" >&2
  exit 1
fi

mkdir -p "$HOME/Applications"
rm -rf "$DEST"
cp -R "$BUILT" "$DEST"
echo "Installed $DEST ($(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$DEST/Contents/Info.plist"))."
echo "Open it with: open \"$DEST\""
